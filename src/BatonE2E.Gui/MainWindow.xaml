<Window x:Class="BatonE2E.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="720" MinWidth="620" MinHeight="520"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 上部: タブ（中身とつながったデザイン）とログ開閉 -->
    <DockPanel Grid.Row="0" LastChildFill="False">
      <ToggleButton x:Name="tglLog" DockPanel.Dock="Right" Style="{StaticResource ToggleChoice}" IsChecked="True" Margin="0,0,0,6"/>
      <RadioButton x:Name="rbMain" DockPanel.Dock="Left" Style="{StaticResource TabButton}" GroupName="nav" IsChecked="True"/>
      <RadioButton x:Name="rbSettings" DockPanel.Dock="Left" Style="{StaticResource TabButton}" GroupName="nav"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="380"/>
        <ColumnDefinition x:Name="colLog" Width="410"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="tabBody" Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="0,6,6,6" Padding="14">
      <Grid x:Name="pLeft">
      <!-- 配信画面 -->
      <Grid x:Name="pMain">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" CornerRadius="6" Padding="14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock x:Name="tbState" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="tbSource" Margin="0,6,0,0"/>
              <TextBlock x:Name="tbStats" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="tbEnc" Margin="0,2,0,0" FontWeight="SemiBold"/>
              <TextBlock x:Name="tbSecWarn" Margin="0,6,0,0" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
              <TextBlock x:Name="tbError" Margin="0,6,0,0" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="btnStartStop" Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" MinWidth="150"/>
          </Grid>
        </Border>

        <TextBlock x:Name="tbHint" Grid.Row="1" Margin="2,10,2,6" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="tbBoxSource" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid x:Name="gSource">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="14">
              <StackPanel>
                <TextBlock x:Name="tbBoxView" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid x:Name="gView">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="tbTunnel" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbRegen" Margin="0,4,0,0" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 設定画面: 入力欄は code-behind で組み立てる（見出し：入力欄、詳細はⓘ） -->
      <Grid x:Name="pSettings" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="gSet" Margin="2,2,14,8"/>
        </ScrollViewer>
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="0,10,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
          <StackPanel>
            <WrapPanel>
              <Button x:Name="btnSave" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
              <Button x:Name="btnRestore" Margin="0,0,8,4"/>
              <Button x:Name="btnTemplate" Margin="0,0,8,4"/>
              <Button x:Name="btnOpenFolder" Margin="0,0,12,4"/>
              <TextBlock x:Name="tbDirty" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" Margin="0,0,0,4" Visibility="Collapsed"/>
            </WrapPanel>
            <TextBlock x:Name="tbSetMsg" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Border>
      </Grid>
      </Grid>
      </Border>
      <!-- ログ画面 -->
      <Grid x:Name="pLog" Grid.Column="1" Margin="10,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
          <RadioButton x:Name="rbLogAll" Style="{StaticResource ChoiceButton}" GroupName="lv" IsChecked="True"/>
          <RadioButton x:Name="rbLogWarn" Style="{StaticResource ChoiceButton}" GroupName="lv"/>
          <Button x:Name="btnLogCopy" Margin="12,0,6,0"/>
          <Button x:Name="btnLogSave" Margin="0,0,6,0"/>
          <Button x:Name="btnLogClear" Margin="0,0,12,0"/>
          <TextBlock x:Name="tbLogCount" Foreground="{StaticResource MutedBrush}"/>
        </WrapPanel>
        <TextBox x:Name="txtLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, MS Gothic" FontSize="12" VerticalContentAlignment="Top"/>
      </Grid>

    </Grid>
  </Grid>
</Window>
