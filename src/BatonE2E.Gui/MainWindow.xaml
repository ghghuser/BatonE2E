<Window x:Class="BatonE2E.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1180" Height="720" MinWidth="820" MinHeight="520"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI, Segoe UI" FontSize="13">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 上部: 画面切り替えとログ開閉 -->
    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
      <ToggleButton x:Name="tglLog" DockPanel.Dock="Right" Style="{StaticResource ToggleChoice}" IsChecked="True"/>
      <RadioButton x:Name="rbMain" DockPanel.Dock="Left" Style="{StaticResource ChoiceButton}" GroupName="nav" IsChecked="True"/>
      <RadioButton x:Name="rbSettings" DockPanel.Dock="Left" Style="{StaticResource ChoiceButton}" GroupName="nav"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="380"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition x:Name="colLog" Width="400"/>
      </Grid.ColumnDefinitions>
      <GridSplitter x:Name="splitLog" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="Transparent" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
      <Grid x:Name="pLeft" Grid.Column="0">
      <!-- 配信画面 -->
      <Grid x:Name="pMain">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock x:Name="tbState" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="tbSource" Margin="0,6,0,0"/>
              <TextBlock x:Name="tbStats" Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="tbEnc" Margin="0,2,0,0" FontWeight="SemiBold"/>
              <TextBlock x:Name="tbError" Margin="0,6,0,0" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="btnStartStop" Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top" MinWidth="150"/>
          </Grid>
        </Border>

        <TextBlock x:Name="tbHint" Grid.Row="1" Margin="2,10,2,6" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="tbBoxSource" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid x:Name="gSource">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                </Grid>
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14">
              <StackPanel>
                <TextBlock x:Name="tbBoxView" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid x:Name="gView">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                </Grid>
                <TextBlock x:Name="tbTunnel" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbRegen" Margin="0,4,0,0" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 設定画面 -->
      <ScrollViewer x:Name="pSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="16">
          <StackPanel>
            <TextBlock x:Name="lblLang" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <RadioButton x:Name="rbLangJa" Content="日本語" Style="{StaticResource ChoiceButton}" GroupName="lang"/>
              <RadioButton x:Name="rbLangEn" Content="English" Style="{StaticResource ChoiceButton}" GroupName="lang"/>
            </StackPanel>

            <TextBlock x:Name="lblSrcPort" Margin="0,0,0,4"/>
            <TextBox x:Name="tbSrcPort" Width="120" HorizontalAlignment="Left" Margin="0,0,0,10"/>
            <TextBlock x:Name="lblViewPort" Margin="0,0,0,4"/>
            <TextBox x:Name="tbViewPort" Width="120" HorizontalAlignment="Left" Margin="0,0,0,10"/>
            <TextBlock x:Name="lblMount" Margin="0,0,0,4"/>
            <TextBox x:Name="tbMount" Margin="0,0,0,10"/>

            <TextBlock x:Name="lblSrcPass" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="tbSrcPass"/>
              <Button x:Name="btnGenSrc" Grid.Column="1" Margin="6,0,0,0"/>
            </Grid>
            <TextBlock x:Name="lblViewPass" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="tbViewPass"/>
              <Button x:Name="btnGenView" Grid.Column="1" Margin="6,0,0,0"/>
            </Grid>
            <TextBlock x:Name="lblPassNote" Margin="0,0,0,10" Foreground="{StaticResource MutedBrush}"/>

            <TextBlock x:Name="lblPageTitle" Margin="0,0,0,4"/>
            <TextBox x:Name="tbPageTitle" Margin="0,0,0,10"/>
            <TextBlock x:Name="lblMaxViewers" Margin="0,0,0,4"/>
            <TextBox x:Name="tbMaxViewers" Width="120" HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <TextBlock x:Name="lblTls" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton x:Name="rbTlsAuto" Style="{StaticResource ChoiceButton}" GroupName="tls"/>
              <RadioButton x:Name="rbTlsOn" Style="{StaticResource ChoiceButton}" GroupName="tls"/>
              <RadioButton x:Name="rbTlsOff" Style="{StaticResource ChoiceButton}" GroupName="tls"/>
            </StackPanel>

            <CheckBox x:Name="chkAnyUser" Margin="0,0,0,8"/>
            <CheckBox x:Name="chkLogFile" Margin="0,0,0,14"/>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="btnSave" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
              <Button x:Name="btnRestore" Margin="0,0,8,0"/>
              <Button x:Name="btnOpenFolder"/>
            </StackPanel>
            <TextBlock x:Name="tbSetMsg" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </Border>
      </ScrollViewer>
      </Grid>
      <!-- ログ画面 -->
      <Grid x:Name="pLog" Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
          <RadioButton x:Name="rbLogAll" Style="{StaticResource ChoiceButton}" GroupName="lv" IsChecked="True"/>
          <RadioButton x:Name="rbLogWarn" Style="{StaticResource ChoiceButton}" GroupName="lv"/>
          <Button x:Name="btnLogCopy" Margin="12,0,6,0"/>
          <Button x:Name="btnLogSave" Margin="0,0,6,0"/>
          <Button x:Name="btnLogClear" Margin="0,0,12,0"/>
          <TextBlock x:Name="tbLogCount" Foreground="{StaticResource MutedBrush}"/>
        </WrapPanel>
        <TextBox x:Name="txtLog" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, MS Gothic" FontSize="12" VerticalContentAlignment="Top"/>
      </Grid>

    </Grid>
  </Grid>
</Window>
